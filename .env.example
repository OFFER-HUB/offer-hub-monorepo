NEXT_PUBLIC_API_URL=http://localhost:4000

# OfferHub SDK
OFFERHUB_API_KEY=your_offerhub_api_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Database URLs (optional, for backend/migrations)
DATABASE_URL=your_database_url_here
DIRECT_URL=your_direct_database_url_here

# Production Domain
NEXT_PUBLIC_SITE_URL=https://offer-hub.tech

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# GDPR data-rights confirmation emails (server-only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM=OFFER-HUB <privacy@your-domain.com>

# Public API rate limiting (server-only; required, including for local API calls).
# See docs/security/public-api-rate-limiting.md before deploying.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
# Separate environments sharing a Redis database should use distinct namespaces.
RATE_LIMIT_NAMESPACE=offerhub:production:rl:v1
# Leave empty on Vercel. Else name a single-IP header OVERWRITTEN by your ingress.
# Without a trusted header, all callers share an "unknown" IP budget.
RATE_LIMIT_IP_HEADER=
